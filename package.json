{
  "name": "asistan-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "predev": "node scripts/ensure-db-ready.mjs",
    "rezervasyon:dev": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --turbopack",
    "mobile:dev": "npm --prefix mobile run dev",
    "mobile:web:full": "node scripts/dev-mobile-web.mjs",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:ios": "npm --prefix mobile run ios",
    "build": "next build",
    "postinstall": "node scripts/prisma-generate.mjs",
    "start": "next start",
    "lint": "eslint .",
    "check:production": "tsx scripts/verify-production-readiness.ts",
    "check:public-env": "tsx scripts/check-public-env-allowlist.ts",
    "production:rollout": "node scripts/ensure-db-ready.mjs --prisma && node scripts/migrate-patient-files-to-storage.mjs --apply --validate --i-know-this-bypasses-rls && pnpm check:rls-policies && pnpm check:production",
    "check:rls-inventory": "tsx scripts/audit-rls-prisma.ts",
    "check:rls-policies": "tsx scripts/audit-rls-policies.ts",
    "check:action-validation": "tsx scripts/audit-action-validation.ts",
    "check:legacy-schema": "node scripts/audit-legacy-public-schema.mjs --require-empty",
    "check:schema-drift": "tsx scripts/check-schema-drift.ts",
    "smoke:asistan-app-rls": "tsx scripts/smoke-asistan-app-rls.ts",
    "smoke:cross-tenant": "tsx scripts/smoke-cross-tenant.ts",
    "smoke:booking-canary": "tsx --require ./scripts/shim-server-only.cjs scripts/smoke-booking-canary.ts",
    "check:bundle-budget": "tsx scripts/check-bundle-budget.ts",
    "check:lighthouse": "tsx scripts/run-lighthouse-ci.ts",
    "db:asistan-app:switch": "node scripts/apply-asistan-app-role-switch.mjs",
    "check:supabase-admin": "node scripts/check-supabase-admin-key.mjs",
    "db:push": "prisma db push",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:rls:apply": "node scripts/apply-rls-stack.mjs",
    "db:asistan-app:session-bootstrap": "node scripts/apply-asistan-app-session-bootstrap.mjs",
    "db:files:migrate": "node scripts/migrate-patient-files-to-storage.mjs",
    "db:files:migrate:apply": "node scripts/migrate-patient-files-to-storage.mjs --apply --i-know-this-bypasses-rls",
    "db:deploy": "node scripts/ensure-db-ready.mjs --prisma",
    "db:ready": "node scripts/ensure-db-ready.mjs",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@sentry/nextjs": "^10.56.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.40.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.564.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "lighthouse": "12.8.2",
    "pg": "^8.21.0",
    "postcss": "^8.5",
    "prisma": "^5.22.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.19.2",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
