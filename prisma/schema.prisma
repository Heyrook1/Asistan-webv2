// Asistan Health — production data model
// Single Postgres database (Supabase). Supabase Auth is the source of truth
// for credentials; this schema mirrors the auth.user.id into User.id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────────

enum TeamRole {
  SUPER_ADMIN
  ISLETME_SAHIBI
  DOKTOR
  SEKRETER
  PERSONEL
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TreatmentStatus {
  PLANLANDI
  DEVAM_EDIYOR
  TAMAMLANDI
  IPTAL
}

enum PlanItemStatus {
  AKTIF
  PLANLANDI
  BEKLIYOR
  TAMAMLANDI
}

enum FileCategory {
  TAHLIL
  GORUNTU
  RECETE
  RAPOR
  KIMLIK
  DIGER
}

enum NotificationType {
  APPOINTMENT
  PATIENT
  TEAM
  SYSTEM
}

enum TimelineEventType {
  PATIENT_CREATED
  PATIENT_UPDATED
  NOTE_ADDED
  MEDICATION_ADDED
  ALLERGY_ADDED
  TREATMENT_ADDED
  LAB_RESULT_ADDED
  FILE_UPLOADED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_COMPLETED
  APPOINTMENT_CANCELLED
}

// ────────────────────────────────────────────────────────────────────────────
// Core
// ────────────────────────────────────────────────────────────────────────────

model User {
  id            String       @id @default(uuid()) // mirrors supabase auth.uid
  email         String       @unique
  fullName      String
  phone         String?
  avatarUrl     String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  ownedBusiness Business?    @relation("BusinessOwner")
  memberships   TeamMember[]
  notifications Notification[]

  @@index([email])
}

model Business {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  ownerUserId String       @unique
  description String?
  phone       String?
  email       String?
  address     String?
  city        String?
  logoUrl     String?
  primaryColor String      @default("#12C8AD")
  currency    String       @default("TRY")
  timezone    String       @default("Europe/Istanbul")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  owner         User           @relation("BusinessOwner", fields: [ownerUserId], references: [id])
  members          TeamMember[]
  patients         Patient[]
  services         Service[]
  appointments     Appointment[]
  notes            PatientNote[]
  medications      Medication[]
  allergies        Allergy[]
  treatments       Treatment[]
  treatmentPlans   TreatmentPlanItem[]
  labResults       LabResult[]
  files            PatientFile[]
  timeline         TimelineEvent[]
  notifications    Notification[]

  @@index([slug])
}

model TeamMember {
  id          String   @id @default(uuid())
  businessId  String
  userId      String?  // null until invite is accepted
  fullName    String
  email       String
  phone       String?
  role        TeamRole @default(PERSONEL)
  permissions String[] @default([])
  color       String   @default("#16A9E8")
  isActive    Boolean  @default(true)
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments     Appointment[]
  assignedPatients Patient[]     @relation("PatientAssignedDoctor")

  @@unique([businessId, email])
  @@index([businessId])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────
// Clinical
// ────────────────────────────────────────────────────────────────────────────

model Patient {
  id                    String   @id @default(uuid())
  businessId            String
  patientNumber         String
  fullName              String
  identityNumber        String?
  birthDate             DateTime?
  gender                String?
  bloodType             String?
  phone                 String
  email                 String?
  address               String?
  city                  String?
  emergencyContactName  String?
  emergencyContactPhone String?
  occupation            String?
  insuranceProvider     String?
  chronicDiseases       String?
  familyHistory         String?
  patientStory          String?  @db.Text
  // Hasta kartı için "hızlı bakış" alanları
  lastDiagnosis         String?
  currentTreatment      String?
  riskNote              String?  @db.Text
  summary               String?  @db.Text
  aiSuggestions         Json?    // [{ icon, title, type }]
  assignedDoctorId      String?
  tags                  String[] @default([])
  isArchived            Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignedDoctor   TeamMember?         @relation("PatientAssignedDoctor", fields: [assignedDoctorId], references: [id], onDelete: SetNull)
  notes            PatientNote[]
  medications      Medication[]
  allergies        Allergy[]
  treatments       Treatment[]
  treatmentPlan    TreatmentPlanItem[]
  labResults       LabResult[]
  files            PatientFile[]
  appointments     Appointment[]
  timeline         TimelineEvent[]

  @@unique([businessId, patientNumber])
  @@index([businessId, fullName])
  @@index([businessId, phone])
  @@index([businessId, email])
  @@index([businessId, identityNumber])
  @@index([businessId, isArchived])
}

model PatientNote {
  id         String   @id @default(uuid())
  businessId String
  patientId  String
  title      String
  note       String   @db.Text
  createdBy  String   // user id or display name
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, patientId])
}

model Medication {
  id         String    @id @default(uuid())
  businessId String
  patientId  String
  name       String
  dosage     String?
  frequency  String?
  startDate  DateTime?
  endDate    DateTime?
  notes      String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, patientId])
}

model Allergy {
  id         String   @id @default(uuid())
  businessId String
  patientId  String
  name       String
  severity   String   @default("ORTA") // HAFIF | ORTA | SIDDETLI
  reaction   String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, patientId])
}

model Treatment {
  id          String          @id @default(uuid())
  businessId  String
  patientId   String
  title       String
  description String?         @db.Text
  doctorName  String?
  startDate   DateTime?
  endDate     DateTime?
  status      TreatmentStatus @default(PLANLANDI)
  cost        Decimal?        @db.Decimal(10, 2)
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, patientId])
}

model TreatmentPlanItem {
  id          String         @id @default(uuid())
  businessId  String
  patientId   String
  title       String
  frequency   String?        // "Her gün", "2 hafta içinde", "Gerektiğinde"
  status      PlanItemStatus @default(PLANLANDI)
  order       Int            @default(0)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, patientId, order])
}

model LabResult {
  id          String   @id @default(uuid())
  businessId  String
  patientId   String
  title       String
  description String?  @db.Text
  resultDate  DateTime
  labName     String?
  fileUrl     String?  // points to Supabase Storage / S3 once integrated
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, patientId])
}

model PatientFile {
  id           String       @id @default(uuid())
  businessId   String
  patientId    String
  fileName     String
  fileType     String       // mime type
  fileSize     Int?         // bytes
  category     FileCategory @default(DIGER)
  storageKey   String       // path/key inside the bucket — TODO wire Supabase Storage / S3
  fileUrl      String       // signed url at creation time (refreshed by signer later)
  description  String?
  uploadedBy   String?
  uploadedAt   DateTime     @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, patientId])
  @@index([businessId, category])
}

// ────────────────────────────────────────────────────────────────────────────
// Scheduling
// ────────────────────────────────────────────────────────────────────────────

model Service {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  description String?
  category    String?
  durationMin Int      @default(30)
  price       Decimal  @db.Decimal(10, 2) @default(0)
  currency    String   @default("TRY")
  color       String   @default("#12C8AD")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([businessId, isActive])
}

model Appointment {
  id         String            @id @default(uuid())
  businessId String
  patientId  String
  serviceId  String
  staffId    String?
  date       DateTime          @db.Date
  startTime  String            // HH:mm
  endTime    String            // HH:mm
  status     AppointmentStatus @default(SCHEDULED)
  price      Decimal?          @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service  Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff    TeamMember?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([businessId, date])
  @@index([businessId, status])
  @@index([businessId, patientId])
  @@index([businessId, staffId])
}

// ────────────────────────────────────────────────────────────────────────────
// Activity
// ────────────────────────────────────────────────────────────────────────────

model TimelineEvent {
  id          String            @id @default(uuid())
  businessId  String
  patientId   String?
  type        TimelineEventType
  title       String
  description String?
  actorName   String?
  actorId     String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, patientId, createdAt])
}

model Notification {
  id         String           @id @default(uuid())
  businessId String
  userId     String?          // recipient; null = broadcast to all members
  type       NotificationType @default(SYSTEM)
  title      String
  message    String
  link       String?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, isRead, createdAt])
  @@index([userId, isRead, createdAt])
}
