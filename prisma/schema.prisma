// Asistan Health — production data model
// Single Postgres database (Supabase). Supabase Auth is the source of truth
// for credentials; this schema mirrors the auth.user.id into User.id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────────

enum TeamRole {
  SUPER_ADMIN
  ISLETME_SAHIBI
  DOKTOR
  SEKRETER
  PERSONEL
}

enum VendorMembershipStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum VendorAccountSource {
  SELF_SIGNUP
  ADMIN_CREATED
}

enum MembershipPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum MembershipBillingPeriod {
  MONTHLY
  YEARLY
}

enum MembershipPaymentProvider {
  MANUAL
  STRIPE
}

enum AppointmentDepositStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  WAIVED
  REFUNDED
}

enum AppointmentDepositProvider {
  MANUAL
  STRIPE
}

enum ClinicInvoiceStatus {
  DRAFT
  READY
  SUBMITTED
  FAILED
  VOID
}

enum ClinicInvoiceKind {
  SERVICE
  SMM_TR
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  DASHBOARD
  CLIENT_APP
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
}

enum UnavailableBlockSource {
  MANUAL
  GOOGLE_CALENDAR
  OUTLOOK
}

enum TreatmentStatus {
  PLANLANDI
  DEVAM_EDIYOR
  TAMAMLANDI
  IPTAL
}

enum PlanItemStatus {
  AKTIF
  PLANLANDI
  BEKLIYOR
  TAMAMLANDI
}

enum FileCategory {
  TAHLIL
  GORUNTU
  RECETE
  RAPOR
  KIMLIK
  DIGER
}

// ── Patient-owned (Person-scoped) health records ────────────────────────────
/// Provenance of a Person-scoped health record. "verified" chrome is only shown
/// when provenance can genuinely be verified (never for PATIENT_ENTERED).
enum HealthRecordSource {
  PATIENT_ENTERED
  CLINIC_ENTERED
  PROVIDER_ENTERED
  SYSTEM_IMPORTED
}

enum PersonMedicationStatus {
  ACTIVE
  ENDED
  ARCHIVED
}

enum PersonAllergySeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

enum PersonDocumentCategory {
  LAB_RESULT
  MEDICAL_REPORT
  IMAGING
  PRESCRIPTION
  VISIT_DOCUMENT
  REFERRAL
  OTHER
}

/// Record visibility baseline — always PRIVATE until the patient shares via Passport.
enum HealthRecordVisibility {
  PRIVATE
  SHAREABLE
}

enum NotificationType {
  APPOINTMENT
  PATIENT
  TEAM
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationActionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum NotificationActionType {
  APPOINTMENT_APPROVE
  APPOINTMENT_CANCEL
  APPOINTMENT_RESCHEDULE
  OPEN_LINK
  OPEN_PATIENT
  OPEN_APPOINTMENT
  ACK
}

enum ReminderPriority {
  LOW
  NORMAL
  HIGH
}

enum ClientNotificationType {
  BOOKING_CONFIRMATION
  BOOKING_PENDING
  BOOKING_APPROVED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  APPOINTMENT_REMINDER
  REVIEW_REQUEST
}

enum PrescriptionStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum TimelineEventType {
  PATIENT_CREATED
  PATIENT_UPDATED
  NOTE_ADDED
  MEDICATION_ADDED
  ALLERGY_ADDED
  TREATMENT_ADDED
  LAB_RESULT_ADDED
  FILE_UPLOADED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_COMPLETED
  APPOINTMENT_CANCELLED
  INTAKE_SUBMITTED
}

enum IntakeFieldType {
  TEXT
  TEXTAREA
  SELECT
  CHECKBOX
  PHONE
  DATE
}

enum IntakeInviteStatus {
  PENDING
  SUBMITTED
  EXPIRED
  REVOKED
}

enum AuditSeverity {
  DEBUG
  INFO
  WARN
  ERROR
  CRITICAL
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  KVKK_EXPLICIT
  MARKETING_EMAILS
  MARKETING_SMS
  DATA_SHARING_THIRD_PARTY
  HEALTH_DATA_PROCESSING
}

enum DataDeletionStatus {
  PENDING
  IN_REVIEW
  COMPLETED
  REJECTED
}

// ────────────────────────────────────────────────────────────────────────────
// Core
// ────────────────────────────────────────────────────────────────────────────

model User {
  id                       String                    @id @default(uuid()) // mirrors supabase auth.uid
  email                    String                    @unique
  fullName                 String
  phone                    String?
  avatarUrl                String?
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  ownedBusiness            Business?                 @relation("BusinessOwner")
  memberships              TeamMember[]
  notifications            Notification[]
  notificationsActor       Notification[]            @relation("NotificationActor")
  pushSubscriptions        PushSubscription[]
  reminders                Reminder[]
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("MessageSender")
  messageReactions         MessageReaction[]
  patientNotesCreated      PatientNote[]             @relation("PatientNoteCreator")
  auditLogs                AuditLog[]                @relation("AuditActor")
  auditLogsProcessed       DataDeletionRequest[]     @relation("DeletionProcessor")
  consents                 UserConsent[]
  deletionRequests         DataDeletionRequest[]     @relation("DeletionRequester")

  @@index([email])
}

model Business {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  ownerUserId  String   @unique
  description  String?
  phone        String?
  email        String?
  address      String?
  city         String?
  locationLat  Decimal? @db.Decimal(9, 6)
  locationLng  Decimal? @db.Decimal(9, 6)
  logoUrl      String?
  primaryColor String   @default("#12C8AD")
  currency     String   @default("TRY")
  timezone     String   @default("Asia/Nicosia")
  autoConfirmClientAppointments Boolean @default(false)
  /// When true, public /book requires KKTC/TC/passport. Default false (P0.6 minimization).
  requireGuestIdentity Boolean @default(false)
  /// Public book deposit policy (Q3). Amount required when depositEnabled.
  depositEnabled Boolean @default(false)
  depositAmount  Decimal? @db.Decimal(10, 2)
  /// No-show fee policy — shown to patients; collection may be manual/later.
  noShowFeeEnabled Boolean @default(false)
  noShowFeeAmount  Decimal? @db.Decimal(10, 2)
  noShowFeeNote    String?
  /// KKTC e-Fatura drafts (not TR GİB e-SMM).
  invoiceEnabled Boolean @default(false)
  taxVkn         String?
  taxOffice      String?
  invoiceTitle   String?
  invoiceAddress String?
  /// WhatsApp front-desk booking agent (rules; not “AI-powered” claim).
  whatsappAgentEnabled Boolean @default(false)
  isActive     Boolean  @default(true)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner             User                @relation("BusinessOwner", fields: [ownerUserId], references: [id])
  vendorAccount     VendorAccount?
  membershipPayments MembershipPayment[]
  appointmentDeposits AppointmentDeposit[]
  clinicInvoices    ClinicInvoice[]
  frontDeskSessions FrontDeskSession[]
  patientChannelAttempts PatientChannelAttempt[]
  notificationOutboxes NotificationOutbox[]
  members           TeamMember[]
  patients          Patient[]
  services          Service[]
  appointments      Appointment[]
  locations         Location[]
  notes             PatientNote[]
  medications       Medication[]
  allergies         Allergy[]
  treatments        Treatment[]
  treatmentPlans    TreatmentPlanItem[]
  labResults        LabResult[]
  files             PatientFile[]
  timeline          TimelineEvent[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  reminders         Reminder[]
  conversations     Conversation[]
  serviceStaff      ServiceStaff[]
  staffAvailabilities TeamMemberAvailability[]
  staffUnavailableBlocks TeamMemberUnavailableBlock[]
  calendarConnections CalendarConnection[]
  intakeForms         IntakeForm[]
  intakeInvites       IntakeInvite[]
  intakeResponses     IntakeResponse[]
  reviews           Review[]
  clientNotifications ClientNotification[]
  prescriptions       Prescription[]
  auditLogs           AuditLog[]
  deletionRequests    DataDeletionRequest[]
  complianceDocs      ComplianceDocument[]

  @@index([slug])
}

model Location {
  id        String   @id @default(uuid())
  businessId String
  name      String
  address   String?
  city      String?
  phone     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  availabilityRules TeamMemberAvailability[]
  unavailableBlocks TeamMemberUnavailableBlock[]

  @@index([businessId, isActive])
  @@index([businessId, sortOrder, name])
}

model VendorAccount {
  id                  String                 @id @default(uuid())
  businessId          String                 @unique
  status              VendorMembershipStatus @default(TRIAL)
  source              VendorAccountSource    @default(ADMIN_CREATED)
  isDemo              Boolean                @default(false)
  plan                String                 @default("STARTER")
  balance             Decimal                @default(0) @db.Decimal(12, 2)
  currency            String                 @default("TRY")
  accessStartAt       DateTime?
  accessEndAt         DateTime?
  packageDurationDays Int?
  notes               String?
  deletedAt           DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([isDemo, accessEndAt])
}

/// Self-serve plan upgrade / renewal payment intent (manual invoice or Stripe).
model MembershipPayment {
  id                  String                     @id @default(uuid())
  businessId          String
  planCode            String
  billingPeriod       MembershipBillingPeriod
  amount              Decimal                    @db.Decimal(12, 2)
  currency            String                     @default("EUR")
  status              MembershipPaymentStatus    @default(PENDING)
  provider            MembershipPaymentProvider  @default(MANUAL)
  providerRef         String?
  checkoutUrl         String?
  packageDurationDays Int
  requestedByUserId   String?
  paidAt              DateTime?
  expiresAt           DateTime?
  notes               String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([providerRef])
  @@index([status, createdAt])
}

/// Patient appointment deposit intent (manual / Stripe). Separate from MembershipPayment.
model AppointmentDeposit {
  id            String                     @id @default(uuid())
  businessId    String
  appointmentId String                     @unique
  amount        Decimal                    @db.Decimal(10, 2)
  currency      String                     @default("TRY")
  status        AppointmentDepositStatus   @default(PENDING)
  provider      AppointmentDepositProvider @default(MANUAL)
  providerRef   String?
  checkoutUrl   String?
  instructions  String?
  paidAt        DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([providerRef])
}

/// Patient SMS / WhatsApp / email send attempts (no contact PII) — ops delivery %.
model PatientChannelAttempt {
  id            String   @id @default(uuid())
  businessId    String
  appointmentId String?
  channel       String
  status        String
  provider      String?
  kind          String?
  createdAt     DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
}

/// Durable patient outbound queue — failed sends retry with backoff (Faz 4).
model NotificationOutbox {
  id            String   @id @default(uuid())
  businessId    String
  appointmentId String?
  patientId     String?
  channel       String
  kind          String
  /// Full ReminderPayload JSON (includes `to` — not shown in patient UI).
  payload       Json
  status        String   @default("pending") // pending | sent | dead
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([businessId, createdAt])
}

/// Clinic service invoice draft (KKTC e-Fatura path). Not TR GİB e-SMM submission.
model ClinicInvoice {
  id               String              @id @default(uuid())
  businessId       String
  appointmentId    String?
  patientId        String?
  kind             ClinicInvoiceKind   @default(SERVICE)
  status           ClinicInvoiceStatus @default(DRAFT)
  number           String?
  currency         String              @default("TRY")
  subtotal         Decimal             @db.Decimal(12, 2)
  taxRate          Decimal             @db.Decimal(5, 2)
  taxAmount        Decimal             @db.Decimal(12, 2)
  total            Decimal             @db.Decimal(12, 2)
  buyerName        String?
  buyerTaxId       String?
  lineItems        Json                @default("[]")
  notes            String?
  provider         String?
  providerRef      String?
  ublPayload       Json?
  lastError        String?
  issuedAt         DateTime?
  submittedAt      DateTime?
  createdByUserId  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patient     Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([appointmentId])
}

/// WhatsApp / channel front-desk conversation draft (slot-engine booking).
model FrontDeskSession {
  id            String   @id @default(uuid())
  businessId    String
  channel       String   @default("whatsapp")
  peerKey       String
  step          String   @default("idle")
  draft         Json     @default("{}")
  lastInboundId String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, channel, peerKey])
  @@index([expiresAt])
}

/// Public booking double-submit protection (Idempotency-Key).
model BookingIdempotency {
  id        String   @id @default(uuid())
  keyHash   String   @unique
  response  Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model TeamMember {
  id          String    @id @default(uuid())
  businessId  String
  userId      String? // null until invite is accepted
  fullName    String
  email       String
  phone       String?
  role        TeamRole  @default(PERSONEL)
  permissions String[]  @default([])
  color       String    @default("#16A9E8")
  specialty   String?
  bio         String?
  prescriptionTitle   String?  @default("Dr.")
  kktcIdentityNo      String?
  medicalLicenseNo    String?
  diplomaNo           String?
  isBookable  Boolean   @default(true)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments     Appointment[]
  assignedPatients Patient[]     @relation("PatientAssignedDoctor")
  serviceAssignments ServiceStaff[]
  availabilityRules TeamMemberAvailability[]
  unavailableBlocks TeamMemberUnavailableBlock[]
  calendarConnections CalendarConnection[]
  reviews          Review[]
  prescriptions    Prescription[] @relation("PrescribingDoctor")

  @@unique([businessId, email])
  @@index([businessId])
  @@index([userId])
  @@index([businessId, isActive])
  @@index([businessId, role])
}

model ClientUser {
  id           String    @id @default(uuid())
  authUserId   String?   @unique
  /// Ecosystem Person link — patient-facing Asistan passport (GPI).
  personId     String?
  fullName     String
  phone        String?
  email        String?   @unique
  locationLat  Decimal?  @db.Decimal(9, 6)
  locationLng  Decimal?  @db.Decimal(9, 6)
  address      String?
  city         String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  person             Person?              @relation(fields: [personId], references: [id], onDelete: SetNull)
  appointments       Appointment[]
  reviews            Review[]
  notifications      ClientNotification[]

  @@index([fullName])
  @@index([city])
  @@index([personId])
}

// ────────────────────────────────────────────────────────────────────────────
// Clinical
// ────────────────────────────────────────────────────────────────────────────

// ────────────────────────────────────────────────────────────────────────────
// Global Person Identity (ecosystem) — clinics hold Patient charts linked via personId
// ────────────────────────────────────────────────────────────────────────────

/// Ecosystem-scoped person. Clinics never "own" this row; Patient is the clinic chart.
model Person {
  id            String    @id @default(uuid())
  /// Opaque display code e.g. GPI-A1B2C3D4E5 — not sequential / enumerable
  gpiDisplay    String    @unique
  phoneE164     String?   @unique
  emailNorm     String?   @unique
  /// HMAC of national ID / passport — never log raw identifiers
  identityHash  String?   @unique
  birthDate     DateTime?
  fullNameCanon String
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patients       Patient[]
  clientUsers    ClientUser[]
  matchesAsLeft  PersonIdentityMatch[] @relation("PersonMatchLeft")
  matchesAsRight PersonIdentityMatch[] @relation("PersonMatchRight")
  medications    PersonMedication[]
  allergies      PersonAllergy[]
  documents      PersonDocument[]

  @@index([fullNameCanon])
  @@index([deletedAt])
}

model PersonIdentityMatch {
  id            String   @id @default(uuid())
  leftPersonId  String
  rightPersonId String
  score         Decimal  @db.Decimal(4, 3)
  method        String
  decidedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime @default(now())

  leftPerson  Person @relation("PersonMatchLeft", fields: [leftPersonId], references: [id], onDelete: Cascade)
  rightPerson Person @relation("PersonMatchRight", fields: [rightPersonId], references: [id], onDelete: Cascade)

  @@index([leftPersonId, rightPersonId])
  @@index([score])
}

/// Clinic-scoped merge ledger — supports undo of patient re-point after accept.
model PersonIdentityMergeLedger {
  id               String    @id @default(uuid())
  businessId       String
  matchId          String
  leftPersonId     String
  rightPersonId    String
  score            Decimal   @db.Decimal(4, 3)
  patientIdsMoved  String[]
  summary          Json?
  acceptedBy       String
  acceptedAt       DateTime  @default(now())
  undoneAt         DateTime?
  undoneBy         String?
  createdAt        DateTime  @default(now())

  @@index([businessId, acceptedAt])
  @@index([matchId])
  @@index([undoneAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Patient-owned health records (ecosystem, Person-scoped) — the patient's own
// longitudinal record under Asistan Passport. NOT businessId-scoped: access is
// gated by the app.person_id GUC + RLS (mirrors passport reads), never by a
// clinic tenant. Clinic-authored records keep their own clinic-scoped models.
// ────────────────────────────────────────────────────────────────────────────

model PersonMedication {
  id                    String                 @id @default(uuid())
  personId              String
  name                  String
  strength              String?
  form                  String?
  frequency             String?
  startDate             DateTime?
  endDate               DateTime?
  instructions          String?                @db.Text
  notes                 String?                @db.Text
  status                PersonMedicationStatus @default(ACTIVE)
  stoppedAt             DateTime?
  sourceType            HealthRecordSource     @default(PATIENT_ENTERED)
  sourceClinicId        String?
  sourceProviderId      String?
  createdByClientUserId String?
  visibility            HealthRecordVisibility @default(PRIVATE)
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, status])
  @@index([personId, deletedAt])
}

model PersonAllergy {
  id                    String                 @id @default(uuid())
  personId              String
  name                  String
  reaction              String?
  severity              PersonAllergySeverity  @default(UNKNOWN)
  firstObservedAt       DateTime?
  notes                 String?                @db.Text
  sourceType            HealthRecordSource     @default(PATIENT_ENTERED)
  sourceClinicId        String?
  sourceProviderId      String?
  createdByClientUserId String?
  visibility            HealthRecordVisibility @default(PRIVATE)
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([personId, deletedAt])
}

model PersonDocument {
  id                     String                 @id @default(uuid())
  personId               String
  title                  String
  category               PersonDocumentCategory @default(OTHER)
  /// Object path inside the private `person-documents` bucket — never a public/signed URL.
  storageKey             String                 @unique
  mimeType               String
  fileSize               Int
  documentDate           DateTime?
  notes                  String?                @db.Text
  sourceType             HealthRecordSource     @default(PATIENT_ENTERED)
  sourceClinicId         String?
  sourceProviderId       String?
  uploadedByClientUserId String?
  visibility             HealthRecordVisibility @default(PRIVATE)
  deletedAt              DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, category])
  @@index([personId, deletedAt])
}

// ────────────────────────────────────────────────────────────────────────────

model Patient {
  id                    String    @id @default(uuid())
  businessId            String
  personId              String?
  patientNumber         String
  fullName              String
  identityNumber        String?
  birthDate             DateTime?
  gender                String?
  bloodType             String?
  phone                 String
  email                 String?
  address               String?
  city                  String?
  emergencyContactName  String?
  emergencyContactPhone String?
  occupation            String?
  insuranceProvider     String?
  chronicDiseases       String?
  familyHistory         String?
  patientStory          String?   @db.Text
  // Hasta kartı için "hızlı bakış" alanları
  lastDiagnosis         String?
  currentTreatment      String?
  riskNote              String?   @db.Text
  summary               String?   @db.Text
  aiSuggestions         Json? // Legacy field name; structured ops hints only — not ML/AI output
  assignedDoctorId      String?
  tags                  String[]  @default([])
  isArchived            Boolean   @default(false)
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  person         Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)
  assignedDoctor TeamMember?         @relation("PatientAssignedDoctor", fields: [assignedDoctorId], references: [id], onDelete: SetNull)
  notes          PatientNote[]
  medications    Medication[]
  allergies      Allergy[]
  treatments     Treatment[]
  treatmentPlan  TreatmentPlanItem[]
  labResults     LabResult[]
  files          PatientFile[]
  appointments   Appointment[]
  timeline       TimelineEvent[]
  prescriptions  Prescription[]
  intakeInvites  IntakeInvite[]
  intakeResponses IntakeResponse[]
  invoices       ClinicInvoice[]

  @@unique([businessId, patientNumber])
  @@index([businessId, fullName])
  @@index([businessId, phone])
  @@index([businessId, email])
  @@index([businessId, identityNumber])
  @@index([businessId, isArchived])
  @@index([businessId, isArchived, updatedAt])
  @@index([personId])
  @@index([businessId, personId])
}

model PatientNote {
  id              String   @id @default(uuid())
  businessId      String
  patientId       String
  title           String
  note            String   @db.Text
  createdBy       String // display snapshot for legacy rows/fallback
  createdByUserId String?
  isPinned        Boolean  @default(false)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  creator  User?    @relation("PatientNoteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([businessId, patientId])
  @@index([createdByUserId])
}

model Medication {
  id         String    @id @default(uuid())
  businessId String
  patientId  String
  name       String
  dosage     String?
  frequency  String?
  startDate  DateTime?
  endDate    DateTime?
  notes      String?
  active     Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, patientId])
}

model Allergy {
  id         String   @id @default(uuid())
  businessId String
  patientId  String
  name       String
  severity   String   @default("ORTA") // HAFIF | ORTA | SIDDETLI
  reaction   String?
  notes      String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, patientId])
}

model Treatment {
  id          String          @id @default(uuid())
  businessId  String
  patientId   String
  title       String
  description String?         @db.Text
  doctorName  String?
  startDate   DateTime?
  endDate     DateTime?
  status      TreatmentStatus @default(PLANLANDI)
  cost        Decimal?        @db.Decimal(10, 2)
  notes       String?         @db.Text
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, patientId])
}

model TreatmentPlanItem {
  id         String         @id @default(uuid())
  businessId String
  patientId  String
  title      String
  frequency  String? // "Her gün", "2 hafta içinde", "Gerektiğinde"
  status     PlanItemStatus @default(PLANLANDI)
  order      Int            @default(0)
  notes      String?
  deletedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, patientId, order])
}

model LabResult {
  id          String   @id @default(uuid())
  businessId  String
  patientId   String
  title       String
  description String?  @db.Text
  resultDate  DateTime
  labName     String?
  fileUrl     String?
  notes       String?  @db.Text
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, patientId])
}

model PatientFile {
  id          String       @id @default(uuid())
  businessId  String
  patientId   String
  fileName    String
  fileType    String
  fileSize    Int?
  category    FileCategory @default(DIGER)
  storageKey  String
  fileUrl     String
  description String?
  uploadedBy  String?
  deletedAt   DateTime?
  uploadedAt  DateTime     @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, patientId])
  @@index([businessId, category])
}

model Prescription {
  id                    String             @id @default(uuid())
  businessId            String
  patientId             String
  doctorId              String
  appointmentId         String?
  protocolNo            String
  status                PrescriptionStatus @default(ISSUED)
  diagnosis             String
  notes                 String?
  allergyWarning        String?
  issuedAt              DateTime           @default(now())
  validUntil            DateTime?
  patientFullName       String
  patientIdentityNumber String?
  patientBirthDate      DateTime?
  patientGender         String?
  patientPhone          String?
  patientAddress        String?
  patientCity           String?
  doctorTitle           String?
  doctorFullName        String
  doctorSpecialty       String?
  doctorKktcIdentityNo  String?
  doctorMedicalLicenseNo String?
  doctorDiplomaNo       String?
  doctorPhone           String?
  clinicName            String
  clinicAddress         String?
  clinicCity            String?
  clinicPhone           String?
  createdByUserId       String?
  /// SHA-256 (peppered) of the patient/pharmacy share token; raw token never stored
  shareTokenHash        String?            @unique
  sharedAt              DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor   TeamMember         @relation("PrescribingDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  lines    PrescriptionLine[]

  @@unique([businessId, protocolNo])
  @@index([businessId, patientId, issuedAt])
  @@index([businessId, doctorId])
}

model PrescriptionLine {
  id             String  @id @default(uuid())
  prescriptionId String
  sortOrder      Int     @default(0)
  drugName       String
  dosage         String?
  frequency      String?
  durationDays   Int?
  quantity       Int?
  form           String?
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId, sortOrder])
}

// ────────────────────────────────────────────────────────────────────────────
// Scheduling
// ────────────────────────────────────────────────────────────────────────────

model Service {
  id           String   @id @default(uuid())
  businessId   String
  name         String
  description  String?
  category     String?
  durationMin  Int      @default(30)
  price        Decimal  @default(0) @db.Decimal(10, 2)
  currency     String   @default("TRY")
  color        String   @default("#12C8AD")
  isActive     Boolean  @default(true)
  intakeFormId String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  intakeForm   IntakeForm?   @relation(fields: [intakeFormId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  staffAssignments ServiceStaff[]
  reviews      Review[]

  @@index([businessId, isActive])
  @@index([intakeFormId])
}

model ServiceStaff {
  id         String   @id @default(uuid())
  businessId String
  serviceId  String
  staffId    String
  isActive   Boolean  @default(true)
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff    TeamMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([serviceId, staffId])
  @@index([businessId, staffId, isActive])
  @@index([businessId, serviceId, isActive])
}

model TeamMemberAvailability {
  id              String   @id @default(uuid())
  businessId      String
  staffId         String
  locationId      String?
  weekday         Int // 0 = Pazar, 6 = Cumartesi
  startTime       String // HH:mm
  endTime         String // HH:mm
  slotIntervalMin Int    @default(15)
  isActive        Boolean @default(true)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    TeamMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([businessId, staffId, weekday, isActive])
  @@index([businessId, locationId, weekday, isActive])
}

model TeamMemberUnavailableBlock {
  id                   String                 @id @default(uuid())
  businessId           String
  staffId              String
  locationId           String?
  date                 DateTime               @db.Date
  startTime            String // HH:mm
  endTime              String // HH:mm
  reason               String?
  source               UnavailableBlockSource @default(MANUAL)
  externalEventId      String?
  calendarConnectionId String?
  syncedAt             DateTime?
  deletedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff              TeamMember         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location           Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  calendarConnection CalendarConnection? @relation(fields: [calendarConnectionId], references: [id], onDelete: Cascade)

  @@index([businessId, staffId, date])
  @@index([businessId, locationId, date])
  @@index([calendarConnectionId, source, deletedAt])
  @@index([calendarConnectionId, externalEventId])
}

/// OAuth connection for importing clinician busy time (FreeBusy). Write-back deferred.
model CalendarConnection {
  id                    String           @id @default(uuid())
  businessId            String
  staffId               String
  provider              CalendarProvider
  calendarId            String           @default("primary")
  accountEmail          String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenExpiresAt        DateTime?
  syncEnabled           Boolean          @default(true)
  lastSyncAt            DateTime?
  lastError             String?
  connectedByUserId     String?
  deletedAt             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  business Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    TeamMember                   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  blocks   TeamMemberUnavailableBlock[]

  @@unique([businessId, staffId, provider])
  @@index([businessId, syncEnabled])
  @@index([provider, syncEnabled, lastSyncAt])
}

model Appointment {
  id         String            @id @default(uuid())
  businessId String
  locationId String?
  patientId  String
  serviceId  String
  staffId    String?
  clientUserId String?
  date       DateTime          @db.Date
  startTime  String // HH:mm
  endTime    String // HH:mm
  status     AppointmentStatus @default(SCHEDULED)
  source     AppointmentSource @default(DASHBOARD)
  price      Decimal?          @db.Decimal(10, 2)
  notes      String?
  deletedAt  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  patient  Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service  Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff    TeamMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  clientUser ClientUser? @relation(fields: [clientUserId], references: [id], onDelete: SetNull)
  review   Review?
  clientNotifications ClientNotification[]
  intakeInvite IntakeInvite?
  intakeResponse IntakeResponse?
  deposit AppointmentDeposit?
  invoices ClinicInvoice[]

  @@index([businessId, date])
  @@index([businessId, status])
  @@index([businessId, patientId])
  @@index([businessId, staffId])
  @@index([businessId, clientUserId, date])
  @@index([businessId, locationId, date])
  @@index([businessId, staffId, date, status])
  @@index([businessId, status, date, startTime])
  @@index([businessId, serviceId, date])
  @@index([businessId, patientId, date])
  @@index([businessId, deletedAt, date])
}

/// Clinic-defined pre-visit questionnaire. fields = [{ id, type, label, required, options?, placeholder? }]
model IntakeForm {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  description String?
  fields      Json
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services  Service[]
  invites   IntakeInvite[]
  responses IntakeResponse[]

  @@index([businessId, isActive])
  @@index([businessId, isDefault])
}

model IntakeInvite {
  id            String             @id @default(uuid())
  businessId    String
  formId        String
  appointmentId String             @unique
  patientId     String
  tokenHash     String             @unique
  status        IntakeInviteStatus @default(PENDING)
  expiresAt     DateTime
  submittedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  form        IntakeForm      @relation(fields: [formId], references: [id], onDelete: Cascade)
  appointment Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  response    IntakeResponse?

  @@index([businessId, status])
  @@index([patientId, status])
  @@index([formId])
}

model IntakeResponse {
  id            String   @id @default(uuid())
  businessId    String
  formId        String
  inviteId      String   @unique
  appointmentId String   @unique
  patientId     String
  answers       Json
  formSnapshot  Json
  submittedAt   DateTime @default(now())

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  form        IntakeForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  invite      IntakeInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, patientId, submittedAt])
}

model Review {
  id                  String   @id @default(uuid())
  businessId          String
  appointmentId       String   @unique
  clientUserId        String
  patientId           String?
  staffId             String?
  serviceId           String?
  rating              Int
  serviceQuality      Int?
  waitingTime         Int?
  communication       Int?
  comment             String?  @db.Text
  deletedAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clientUser   ClientUser   @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  staff        TeamMember?  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([businessId, staffId, createdAt])
  @@index([businessId, serviceId, createdAt])
  @@index([clientUserId, createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Activity
// ────────────────────────────────────────────────────────────────────────────

model TimelineEvent {
  id          String            @id @default(uuid())
  businessId  String
  patientId   String?
  type        TimelineEventType
  title       String
  description String?
  actorName   String?
  actorId     String?
  metadata    Json?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, patientId, createdAt])
}

model Notification {
  id             String               @id @default(uuid())
  businessId     String
  userId         String? // recipient; null = broadcast to all members
  actorUserId    String? // who triggered the event
  type           NotificationType     @default(SYSTEM)
  subtype        String? // appointment_assigned | patient_created | …
  title          String
  message        String
  link           String?
  entityType     String? // appointment | patient | team_member | system
  entityId       String?
  priority       NotificationPriority @default(NORMAL)
  actionRequired Boolean              @default(false)
  metadata       Json?
  isRead         Boolean              @default(false)
  readAt         DateTime?
  archivedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())

  business Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor    User?                @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actions  NotificationAction[]

  @@index([businessId, isRead, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([businessId, entityType, entityId])
  @@index([businessId, archivedAt])
  @@index([businessId, userId, archivedAt, createdAt])
  @@index([businessId, archivedAt, createdAt])
}

model NotificationAction {
  id             String                   @id @default(uuid())
  notificationId String
  label          String
  actionType     NotificationActionType
  payload        Json?
  status         NotificationActionStatus @default(PENDING)
  completedBy    String?
  completedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime                 @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, status])
}

model PushSubscription {
  id         String    @id @default(uuid())
  businessId String
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
}

model Reminder {
  id         String           @id @default(uuid())
  businessId String
  userId     String
  title      String
  note       String?
  dueAt      DateTime?
  isDone     Boolean          @default(false)
  priority   ReminderPriority @default(NORMAL)
  deletedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, userId, isDone, dueAt])
}

model ClientNotification {
  id           String                 @id @default(uuid())
  clientUserId String
  businessId   String?
  appointmentId String?
  type         ClientNotificationType
  title        String
  message      String
  link         String?
  metadata     Json?
  isRead       Boolean                @default(false)
  readAt       DateTime?
  deletedAt    DateTime?
  createdAt    DateTime               @default(now())

  clientUser ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  business   Business?  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([clientUserId, isRead, createdAt])
  @@index([clientUserId, createdAt])
  @@index([businessId, createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Messaging (team chat)
// ────────────────────────────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(uuid())
  businessId    String
  title         String? // null for DMs, set for group chats
  isGroup       Boolean   @default(false)
  directKey     String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  business     Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([businessId, lastMessageAt])
  @@index([businessId, directKey])
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderUserId   String
  body           String    @default("") @db.Text
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                 @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]
  reactions    MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([senderUserId])
}

model MessageAttachment {
  id         String   @id @default(uuid())
  messageId  String
  fileName   String
  fileType   String
  fileSize   Int
  storageKey String
  fileUrl    String
  deletedAt  DateTime?
  createdAt  DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  deletedAt DateTime?
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────
// Governance — auditability & compliance workflows
// ────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String        @id @default(uuid())
  businessId String?
  actorUserId String?
  action     String
  entityType String
  entityId   String?
  severity   AuditSeverity @default(INFO)
  summary    String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime      @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  actor    User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([severity, createdAt])
}

model UserConsent {
  id          String      @id @default(uuid())
  userId      String
  consentType ConsentType
  version     String
  granted     Boolean
  ipAddress   String?
  userAgent   String?
  grantedAt   DateTime    @default(now())
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
  @@index([consentType, grantedAt])
}

model DataDeletionRequest {
  id            String             @id @default(uuid())
  businessId    String?
  userId        String
  patientId     String?
  status        DataDeletionStatus @default(PENDING)
  reason        String?
  requestedAt   DateTime           @default(now())
  processedAt   DateTime?
  processedById String?
  notes         String?

  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user        User      @relation("DeletionRequester", fields: [userId], references: [id], onDelete: Cascade)
  processedBy User?     @relation("DeletionProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([businessId, status, requestedAt])
  @@index([userId, requestedAt])
  @@index([status, requestedAt])
}

model ComplianceDocument {
  id          String    @id @default(uuid())
  businessId  String?
  title       String
  category    String
  version     String
  status      String    @default("ACTIVE")
  fileUrl     String?
  notes       String?
  effectiveAt DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, category, status])
  @@index([expiresAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Waitlist (early app registrations)
// ────────────────────────────────────────────────────────────────────────────

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ────────────────────────────────────────────────────────────────────────────
// Marketing capture (landing page forms)
// ────────────────────────────────────────────────────────────────────────────

/// Newsletter opt-ins from the public landing page.
model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Guest demo requests submitted from the marketing site.
model DemoBooking {
  id        String   @id @default(uuid())
  name      String
  clinic    String
  email     String
  date      String
  time      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Marketing contact / demo request form leads (general inquiry — not calendar booking).
model ContactLead {
  id                    String   @id @default(uuid())
  name                  String
  email                 String
  phone                 String
  company               String?
  serviceType           String?
  message               String   @db.Text
  privacyAcceptedAt     DateTime
  privacyNoticeVersion  String
  source                String   @default("contact")
  status                String   @default("NEW")
  createdAt             DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([email])
}

/// KKTC medical-tourism inbound leads (visit-cyprus). Not travel/visa/hotel booking.
model TourismLead {
  id                 String   @id @default(uuid())
  fullName           String
  phone              String
  email              String?
  preferredLang      String   @default("en")
  procedureInterest  String
  travelDates        String?
  clinicSlug         String?
  notes              String?
  source             String   @default("visit-cyprus")
  status             String   @default("NEW")
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([preferredLang])
}

// ────────────────────────────────────────────────────────────────────────────
// Webhook idempotency (provider event de-duplication)
// ────────────────────────────────────────────────────────────────────────────

/// Records processed inbound webhook events so duplicates are skipped.
model ProcessedWebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  eventId     String
  eventType   String?
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([processedAt])
}
